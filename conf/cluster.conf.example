# ============================================================================
# cluster.conf.example - reference for every setting.
# Sourced by every script. Plain bash: KEY=value, no spaces around '='.
#
# DO NOT EDIT THIS FILE. Run `bin/interview.sh` - it detects what it can, asks
# about the rest, and writes conf/cluster.conf for you. This file exists so you
# can see every knob and its meaning in one place.
#
# Everything a site engineer must touch lives in this file. Change nothing
# else to move this repo to another cluster.
# ============================================================================

# ---------------------------------------------------------------- paths -----
# Repo deploy root. Everything below is relative to it unless absolute.
AAT_HOME=/opt/llmb-bringup

RESULTS_DIR="$AAT_HOME/results"          # per-node result files (compat layer)
STATE_DIR="$AAT_HOME/state"              # per-rack / per-group job state
LOG_DIR="$AAT_HOME/log"                  # orchestrator + collector logs
REPORT_DIR="$AAT_HOME/reports"           # CSV reports
LOGS_DIR="$AAT_HOME/logs"                # node_health.sh check output (unchanged)
VALID_CONFIG_DIR="$AAT_HOME/valid-config"

RACK_INVENTORY="$AAT_HOME/conf/inventory/racks.txt"
WORKLOAD_CONF="$AAT_HOME/conf/workloads.conf"

# ------------------------------------------------------------- llmb-run -----
# Shared-filesystem install produced by llmbmarking/install.sh.
# `echo $LLMB_INSTALL` on the head node after install; must be readable by
# the user the orchestrator runs as.
LLMB_INSTALL=/shared/llmb

# Python venv that provides llmb-run. install.sh creates <repo>/llmb_venv.
# Leave empty if llmb-run is already on PATH for the orchestrator user.
LLMB_VENV=/shared/llmbmarking/llmb_venv

# Subcommand used to launch: submit | single | auto
#   26.06+  -> submit  (supports --nodelist/--exclude/--force/--proxy + `jobs`)
#   25.10   -> single   (no placement flags, no `jobs` subcommand)
# 'auto' probes `llmb-run --help` once per run and caches the answer.
LLMB_SUBCOMMAND=auto

# Container image, staged locally on every tray by actions/file_copy.sh.
# llmb-run picks it up from RUN_CONF_IMAGE.
LLMB_IMAGE_NAME=nvidia+nemo+26.04.01.sqsh
LLMB_IMAGE_SRC="$LLMB_INSTALL/images"    # shared source of truth
LLMB_IMAGE_LOCAL=/raid/llmb        # per-tray local staging dir (fast NVMe)
# Set to 0 to run straight from the shared FS (slower start, no staging step).
LLMB_STAGE_IMAGE=1

# ---------------------------------------------------------------- slurm -----
PARTITION=defq
SLURM_ACCOUNT=
GPUS_PER_NODE=4
NODES_PER_RACK=18                        # nodes in one NVLink domain
GPUS_PER_RACK=$((GPUS_PER_NODE * NODES_PER_RACK))

# Slurm topology plugin in use: block | none
# 'block' switches multi-rack placement from --nodelist to --exclude, which is
# the only documented way to pin nodes when topology/block is enforced.
# (--nodelist + block placement => "Requested topology configuration is not
#  available"; see slurm.schedmd.com/topology.html.)
SLURM_TOPOLOGY=block

# Platform profile: supplies rack geometry and NCCL floors. cluster.conf
# generated by the interview sources conf/profiles/$PLATFORM_PROFILE.conf here.
PLATFORM_PROFILE=generic
CLUSTER_NAME=mycluster

# How per-node health checks are triggered: bcm | cron | none
NODE_HEALTH_DRIVER=bcm
BCM_HEAD=""

# ------------------------------------------------------------- policies -----
MAX_JOB_HOURS=6                 # per-node sbatch benchmarks (dcgm etc.)
MAX_RACK_JOB_HOURS=30           # rack-scale llmb jobs (24h soak + 1h init + slack)
MAX_SUBMITS_PER_CYCLE=8         # rate-limit: new llmb jobs per orchestrator pass
SUBMIT_SLEEP=10                 # seconds between submissions in one pass
QUEUE_DEPTH_LIMIT=32            # stop submitting when this many of our jobs are queued

# What to do to the 18 trays of a rack when a rack-scale workload FAILs:
#   drain  - scontrol update state=DRAIN (default; keeps them out of new jobs)
#   none   - record the failure only, leave Slurm state alone
ON_RACK_FAIL=drain

# Re-submit a rack workload that FAILed? 0 = no (human triage via rack-status).
RETRY_FAILED=0
# Re-submit a rack workload whose job hit NODE_FAIL / BOOT_FAIL / requeue?
RETRY_INFRA_FAIL=1
MAX_ATTEMPTS=3

# --------------------------------------------------------------- outlier ----
# Fleet-relative outlier gate, matching the reference implementation:
# a rack is flagged when any metric is more than this fraction below the
# fleet mean of racks that already passed.
OUTLIER_FRAC=0.05
# Minimum number of passing racks before the fleet-relative gate is applied.
OUTLIER_MIN_SAMPLES=8

# ----------------------------------------------------------------- misc -----
# Owner of the results/state tree; the orchestrator refuses to run as root
# unless ALLOW_ROOT=1 (root-created files break the service user's sbatch path).
RUN_AS_USER=svc-bringup
ALLOW_ROOT=0

# Extra env passed verbatim to every llmb-run invocation (space separated
# KEY=VAL). Site-specific NCCL knobs go here, not in the workload table.
# NCCL_SOCKET_IFNAME must name the interface NCCL bootstraps over; the
# interview probes a real node for it. A wrong value hangs jobs at init.
LLMB_EXTRA_ENV="NCCL_SOCKET_IFNAME=<iface>"

# Verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
